# Pinned sources. Update version, URL and sha256 together in one PR.
# FFmpeg publishes GPG signatures (.asc, key FCF986EA15E6E293A5644F10B4322F04D67658D8)
# instead of checksums; the sha256 below was recorded after a good signature check.
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
# Matches https://downloads.xiph.org/releases/opus/SHA256SUMS.txt
OPUS_VERSION=1.6.1
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz
OPUS_SHA256=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1
# Linux builds run in this Alpine image so they link musl (MIT) statically instead of glibc (LGPL).
ALPINE_IMAGE=alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
